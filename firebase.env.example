# Credenciales privadas de Firebase Admin. Nunca uses el prefijo NEXT_PUBLIC_ aqui.
FIREBASE_PROJECT_ID=tu-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_LLAVE_PRIVADA\n-----END PRIVATE KEY-----\n"

# Seguridad del registro
REGISTRATION_OTP_SECRET=genera-un-secreto-aleatorio-de-al-menos-32-caracteres
TURNSTILE_SECRET_KEY=tu-turnstile-secret-key
TURNSTILE_ALLOWED_HOSTNAMES=localhost,tudominio.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=tu-turnstile-site-key

# Envio de correo
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=Hackathon INHACK <registro@tudominio.com>
RESEND_REPLY_TO=contacto@tudominio.com
SEND_REGISTRATION_SUCCESS_EMAIL=true

# Alternativa para entornos Google con Application Default Credentials:
# FIREBASE_USE_APPLICATION_DEFAULT_CREDENTIALS=true
